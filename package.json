{
  "name": "relay-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Anthropic Messages-compatible localhost bridge from Factory Droid BYOK into the official Claude Agent SDK and unmodified Claude Code.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "relay-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "doctor": "tsx scripts/doctor.ts",
    "verify:relay": "tsx scripts/verify-relay.ts",
    "configure-droid": "tsx scripts/configure-droid.ts",
    "control": "tsx scripts/control.ts",
    "configure-hooks": "tsx scripts/configure-hooks.ts",
    "run-droid": "tsx scripts/run-droid.ts",
    "local": "tsx scripts/local.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:protocol": "vitest run tests/protocol",
    "test:sdk-probes": "vitest run tests/sdk-probes",
    "test:e2e:chat": "tsx scripts/run-gated.ts e2e-chat",
    "test:e2e:mission": "tsx scripts/run-gated.ts e2e-mission",
    "probe:upstream": "tsx scripts/probe-upstream.ts",
    "test:resilience": "vitest run tests/resilience",
    "test:g0": "tsx scripts/g0-airgap.ts",
    "evidence:pack": "tsx scripts/collect-evidence.ts",
    "tiny-tasks:dev": "npm --prefix fixtures/tiny-tasks run dev",
    "tiny-tasks:test": "npm --prefix fixtures/tiny-tasks test",
    "generate-droid": "tsx scripts/generate-droid.ts",
    "verify:spec": "tsx scripts/verify-spec-custom.ts --feature spec",
    "verify:custom": "tsx scripts/verify-spec-custom.ts --feature custom",
    "verify:context": "tsx scripts/verify-factory-context.ts",
    "verify:native-schema": "tsx scripts/verify-native-schema.ts",
    "verify:native-policy": "tsx scripts/verify-native-tool-policy.ts",
    "verify:auxiliary": "tsx scripts/verify-auxiliary.ts",
    "verify:mission": "tsx scripts/verify-mission-final.ts",
    "desktop": "tsx scripts/desktop.ts",
    "test:soak": "node --expose-gc --import tsx scripts/soak.ts",
    "verify:long-run": "tsx scripts/live-stability.ts",
    "test:soak:sdk-local": "tsx scripts/sdk-local-soak.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "@cursor/sdk": "1.0.35",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
